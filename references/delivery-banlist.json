{
  "_comment": "交付物无感约束的共享词表。三个校验脚本都读这一份，改口径只改这里。",
  "_usage": "blocked 命中即不合格；advisory 只提示，交人工判断。格式是 [正则, 说明]。",
  "blocked": [
    ["BV[0-9A-Za-z]{10}", "BVID"],
    ["BVID", "BVID 字样"],
    ["bilibili|哔哩哔哩|B站", "视频平台名"],
    ["UP\\s*主", "UP 主"],
    ["讲师|老师|主理人", "素材的讲师信息——读者会看出这份内容出自别人的课程"],
    ["(?<!样)本集", "本集"],
    ["(?<!部)分集", "分集"],
    ["截图", "截图"],
    ["关键画面", "关键画面"],
    ["播放器", "播放器"],
    ["字幕", "字幕"],
    ["时间点", "时间点"],
    ["来源截图", "来源截图"],
    ["根据画面重构", "根据画面重构"],
    ["data-source-", "内部属性 data-source-*"],
    ["manifest\\.json|capture_log\\.jsonl|dedup_keep\\.json|dedup_log\\.jsonl|resample_hints\\.json|notes\\.plan\\.json|pages\\.plan\\.json|subtitle_probe\\.json", "内部文件名"],
    ["bili-2-ppt|bili-pptx|bili-knowledge-tree|bili-document-builder|bili-keyframes|bili-subtitle-asr", "技能名"],
    ["anim-\\d", "动画标记（形状名没洗掉）"],
    ["这份材料|整份材料|本材料|这批材料|这套材料", "把交付物说成「材料」——读者会看出这是二次加工的产物"],
    ["全篇|通篇|本篇", "指代文档自身的说法（「全篇地基」「通篇按十一个主题组织」）"],
    ["这一页|本页|该页|这页|那页", "指代页面的说法——写的是知识，不是第几页"],
    ["读者", "直呼「读者」的元叙述"],
    ["学习顺序|跳着看|阅读顺序", "教读者怎么读这份材料"],
    ["实拍", "把图说成实拍——暴露画面是采集来的"],
    ["画面", "把图说成「画面」——同样暴露采集过程，改用「图上」「图中」"]
  ],
  "advisory": [
    ["合集", "合集"],
    ["视频", "视频"],
    ["OCR", "OCR"],
    ["(?<![A-Za-z])P\\d{1,2}\\b", "P 加分集写法（指标 P95/P99 也会命中；前面挡一位字母是为了不匹配 FP16 / BF16）"],
    ["\\b\\d{1,2}:\\d{2}\\b", "时间码"]
  ]
}
